# .gitignore

# Environment Variables
.env
.env.*

# Python Virtual Environments
.venv/
venv/
env/
ENV/

# Python Cache and Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# OS Generated Files
.DS_Store
Thumbs.db

# Logs and Databases
*.log
*.sqlite3

# Docker
.dockerignore